            <node id="n0::n2::n0">
              <data key="dName">Ввод номера квартиры</data>
              <data key="dData">КЛАВИША_ЦИФРА(n)/
квартира += n
дисплей_квартира(квартира)
</data>
              <data key="dGeometry">
                <rect x="250.000000" y="73.000000" width="325.000000" height="125.000000"/>
              </data>
            </node>
