              </data>
            </node>
            <node id="n0::n2::n3">
              <data key="dName">Ввод кода</data>
              <data key="dData">entry/
дисплей_код()
код = ''

КЛАВИША_ЦИФРА(n) [len(код) &lt; 3]/
код += n
</data>
              <data key="dGeometry">
                <rect x="600.000000" y="273.000000" width="200.000000" height="175.000000"/>
              </data>
            </node>
            <node id="n0::n2::n4">
              <data key="dName">Вызов</data>
              <data key="dData">entry/
дисплей_вызов()
звук_вызов()
