  <graph id="G0" edgedefault="directed">
    <data key="dStateMachine"/>
    <data key="dName">The Game Timer Box</data>
    <data key="dGeometry">
      <rect x="-800.000000" y="-525.000000" width="1375.000000" height="1125.000000"/>
    </data>
    <node id="nMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

cyberiadaEditorView/ 0.916938 -973 -627

geometry/ full

transitionOrder/ actionFirst

eventPropagation/ block</data>
    </node>
    <node id="n0">
      <data key="dName">Setup</data>
      <data key="dData">entry/
hal_led_light(PLAYER_RED, 0);
hal_led_light(PLAYER_GREEN, 0);
hal_display_setup();

KEY_LEFT [time_mode &gt; 60]/
time_mode -= 60;
hal_display_setup();

KEY_RIGHT/
time_mode += 60;
hal_display_setup();
</data>
      <data key="dGeometry">
        <rect x="25.000000" y="100.000000" width="350.000000" height="250.000000"/>
      </data>
    </node>
    <node id="n1">
      <data key="dName">Game</data>
      <data key="dData">entry/
red = green = 0;
hal_timer_start(time_mode);
hal_display_game();
</data>
      <data key="dGeometry">
        <rect x="400.000000" y="100.000000" width="950.000000" height="550.000000"/>
      </data>
      <graph id="n1:" edgedefault="directed">
        <node id="n1::n0">
          <data key="dName">Wait</data>
          <data key="dData">TIMER_1SEC/
hal_display_game();
</data>
          <data key="dGeometry">
            <rect x="350.000000" y="144.500000" width="250.000000" height="100.000000"/>
          </data>
        </node>
        <node id="n1::n1">
          <data key="dName">Red</data>
          <data key="dData">entry/
hal_led_light(PLAYER_RED, 1);
hal_led_light(PLAYER_GREEN, 0);
hal_display_game();

TIMER_1SEC/
red++;
hal_display_game();
</data>
          <data key="dGeometry">
            <rect x="25.000000" y="269.500000" width="350.000000" height="200.000000"/>
          </data>
        </node>
        <node id="n1::n2">
          <data key="dName">Green</data>
          <data key="dData">entry/
hal_led_light(PLAYER_GREEN, 1);
hal_led_light(PLAYER_RED, 0);
hal_display_game();

TIMER_1SEC/
green++;
hal_display_game();
</data>
          <data key="dGeometry">
            <rect x="575.000000" y="269.500000" width="350.000000" height="200.000000"/>
          </data>
        </node>
        <node id="n1::n3">
          <data key="dVertex">initial</data>
          <data key="dGeometry">
            <point x="475.000000" y="94.500000"/>
          </data>
        </node>
      </graph>
    </node>
    <node id="n2">
      <data key="dName">Results</data>
      <data key="dData">entry/
hal_display_final();
</data>
      <data key="dGeometry">
        <rect x="400.000000" y="700.000000" width="950.000000" height="400.000000"/>
      </data>
      <graph id="n2:" edgedefault="directed">
        <node id="n2::n0">
          <data key="dVertex">initial</data>
          <data key="dGeometry">
            <point x="475.000000" y="48.000000"/>
          </data>
        </node>
        <node id="n2::n1">
          <data key="dVertex">choice</data>
          <data key="dGeometry">
            <rect x="454.490562" y="88.267912" width="40.000000" height="40.000000"/>
          </data>
        </node>
        <node id="n2::n2">
          <data key="dName">Tie</data>
          <data key="dGeometry">
            <rect x="400.000000" y="173.000000" width="150.000000" height="50.000000"/>
          </data>
        </node>
        <node id="n2::n3">
          <data key="dName">Red Won</data>
          <data key="dData">entry/
hal_led_light(PLAYER_RED, 1);
hal_led_light(PLAYER_GREEN, 0);

TIMER_1SEC/
hal_led_toggle(PLAYER_RED);
</data>
          <data key="dGeometry">
            <rect x="25.000000" y="173.000000" width="350.000000" height="150.000000"/>
          </data>
        </node>
        <node id="n2::n4">
          <data key="dName">Green Won</data>
          <data key="dData">entry/
hal_led_light(PLAYER_RED, 0);
hal_led_light(PLAYER_GREEN, 1);

TIMER_1SEC/
hal_led_toggle(PLAYER_GREEN);
</data>
          <data key="dGeometry">
            <rect x="575.000000" y="173.000000" width="350.000000" height="150.000000"/>
          </data>
        </node>
      </graph>
    </node>
